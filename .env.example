# Django settings
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=ielts_simulator.settings

# Database
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=bandup_ielts
DATABASE_USER=bandup
DATABASE_PASSWORD=bandup_pass

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# JWT
DJANGO_SIMPLE_JWT_ACCESS_TOKEN_LIFETIME=15m
DJANGO_SIMPLE_JWT_REFRESH_TOKEN_LIFETIME=7d

# Storage
DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage
MEDIA_URL=/media/
MEDIA_ROOT=media

# Other
FRONTEND_URL=http://localhost:3000
